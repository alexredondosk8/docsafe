# Copia este archivo como .env y ajusta los valores. El archivo .env NO se versiona.

# --- Django ---
# Genera una clave con:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=cambia-esta-clave
# Solo True mientras desarrollas.
DJANGO_DEBUG=False

# --- DocSafe ---
# Tamaño máximo por archivo, en MB.
DOCSAFE_MAX_UPLOAD_MB=20
DOCSAFE_TIME_ZONE=America/Bogota
DOCSAFE_LOG_LEVEL=INFO
# Carpeta para base de datos, archivos temporales y logs (por defecto ./var).
# DOCSAFE_VAR_DIR=

# --- Anonimización por reglas ---
# Por defecto solo se reemplazan fechas de nacimiento. True = reemplazar TODAS las fechas.
DOCSAFE_ANONIMIZAR_TODAS_LAS_FECHAS=False
# Tipos que NO se anonimizan, separados por comas (vacío = todos activos). Válidos:
# NOMBRE, CEDULA, PASAPORTE, NIT, EMPRESA, CORREO, TELEFONO, DIRECCION,
# FECHA_NACIMIENTO, EDAD, CONTRATO, CUENTA, FECHA
DOCSAFE_REGLAS_DESACTIVADAS=

# --- Modelo de lenguaje (API compatible con OpenAI) ---
# Por defecto Ollama local. Si usas una URL que no sea localhost/127.0.0.1,
# tus documentos se enviarán a un servicio externo.
LLM_BASE_URL=http://localhost:11434/v1
# Nombre del modelo tal como aparece en `ollama list`, por ejemplo: qwen3:8b
# Solo se usa este modelo; la aplicación no permite elegir otro desde la web.
LLM_MODEL=
# Ollama no necesita clave; otros proveedores sí. Nunca la compartas.
LLM_API_KEY=
# Tiempo máximo de espera por petición, en segundos.
LLM_TIMEOUT=120
